# Local Windows convenience scripts and Claude Code session state
build_win.bat
.claude/

# Saved scenes written by `scene_save` (scenes/<name>.json) -- user
# scene data, per-workspace scratch, not committed. (Legacy *.toml
# scenes from the pre-JSON scene_save are also ignored.)
scenes/
# ...but the golden-matrix scene fixtures ARE committed source. Without
# this negation `scenes/` above swallows them and a new fixture silently
# never reaches the tree (every existing one had to be added with -f).
!tests/goldens/scenes/
*.toml
!CMakePresets.json
demont_console.state

# Console runtime scratch files (written next to the binary at runtime).
console_history.txt
favorites.cfg

# Local screenshot / capture dumps from FrameCapture, smoke tests,
# and ad-hoc renderdoc-style triage. Not committed -- per-host
# scratch.
captures/

# Python bytecode cache
__pycache__/
*.pyc
golden-result.json

# Locally baked high-resolution planet grids (tools/fetch_planet_dem.py,
# tools/fetch_planet_albedo.py). The committed earth_lite pair is the
# 2048x1024 derivative a source repository can carry; a finer bake is
# 134 MB at --width 8192 and is not committable. The engine prefers one
# of these when it finds it -- see the DEM preference in Engine.cpp.
assets/planet/earth_8k.*
assets/planet/earth_hi.*
